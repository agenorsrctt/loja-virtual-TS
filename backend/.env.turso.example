# Copie para backend/.env.turso e preencha no seu computador.
# Não publique .env.turso. Os valores abaixo são apenas exemplos.
TURSO_DATABASE_URL=libsql://seu-banco-sua-organizacao.turso.io
TURSO_AUTH_TOKEN=preencha-com-o-token-do-banco
JWT_SECRET=preencha-com-um-segredo-aleatorio-longo

# Apenas para criar o SuperAdmin no banco novo. Remova após criar a conta.
SUPERADMIN_EMAIL=seu-email@exemplo.com
SUPERADMIN_SENHA=escolha-uma-senha-exclusiva-com-12-ou-mais-caracteres
